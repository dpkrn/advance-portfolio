# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
MONGODB_URI=mongodb://localhost:27017/advance-portfolio
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Admin Portal ──────────────────────────────────────────────────────────────
# Required to access /admin — change before deploying
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# ── GitHub Integration ────────────────────────────────────────────────────────
# Optional — enables "Sync from GitHub" in the admin panel.
# Create a fine-grained PAT at https://github.com/settings/tokens
# Required permissions (read-only): Repository contents, Metadata, user profile
GITHUB_TOKEN=github_pat_...

# ── Cloudinary (Image Uploads) ────────────────────────────────────────────────
# Optional — enables image uploads for avatar and project thumbnails.
# Get credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── AI "Ask Me Anything" — NVIDIA NIM ────────────────────────────────────────
# Optional — powers the streaming AI chatbot. Without this, falls back to
# a fast rule-based answer engine (no API key needed).
# Get a free API key at https://build.nvidia.com
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Other available models (swap NVIDIA_MODEL value):
#   meta/llama-3.1-8b-instruct   (faster, lighter)
#   mistralai/mistral-7b-instruct-v0.3
#   google/gemma-2-9b-it
